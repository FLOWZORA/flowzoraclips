# ==============================================================================
# FLOWZORA Clips (flowzoraclips.com) — Production Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development, or configure these variables
# in your Vercel / Cloudflare / Railway project dashboard for production.

# ------------------------------------------------------------------------------
# 1. AI ENGINES: GOOGLE GEMINI & SPEECH TRANSCRIPTION
# ------------------------------------------------------------------------------
# Google Gemini API key used for 4-dimension highlight scoring & social copy generation.
# Obtain 100% free from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# [100% FREE 🏆 RECOMMENDED] Groq Whisper Large v3 (word-level timestamps, 10x faster)
# Obtain free from Groq Cloud Console: https://console.groq.com/
GROQ_API_KEY=gsk_YourGroqApiKeyHere

# [OPTIONAL / PAID ALTERNATIVE] OpenAI Whisper API ($0.006/min)
# Obtain from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere

# ------------------------------------------------------------------------------
# 2. DATABASE & AUTHENTICATION: SUPABASE
# ------------------------------------------------------------------------------
# Your Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (safe for public client usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (server-side admin access, bypasses RLS for credit ledgers)
# NEVER expose this key to client-side code!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 3. PAYMENTS & BILLING: STRIPE
# ------------------------------------------------------------------------------
# Stripe Secret Key (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_live_YourStripeSecretKey

# Stripe Publishable Key (for client-side Stripe elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YourStripePublishableKey

# Stripe Webhook Signing Secret (Dashboard > Developers > Webhooks)
# Used to verify webhook events from /api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSecret

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE: CLOUDFLARE R2 (ZERO-EGRESS)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 S3-Compatible API Access Token
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Bucket Name for raw video uploads and rendered clip exports
R2_BUCKET_NAME=flowzora-clips

# Custom public domain or r2.dev domain for public video streaming
R2_PUBLIC_DOMAIN=https://r2.flowzoraclips.com

# ------------------------------------------------------------------------------
# 5. VIDEO PROCESSING WORKER: RAILWAY (FFMPEG)
# ------------------------------------------------------------------------------
# URL of your deployed ffmpeg render worker (optional for local dev).
# This is the name video-exporter.ts reads. RAILWAY_WORKER_URL still works as a
# legacy fallback, but prefer this one -- a mismatch here means the worker is
# silently never called and exports quietly fall back to the local path.
RENDER_WORKER_URL=https://flowzora-worker.onrender.com

# Secret bearer token shared between Next.js server and BOTH workers
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NEVER commit a real value here - this file is tracked in git.
WORKER_SECRET_TOKEN=replace_me_with_a_generated_secret

# Token for the YouTube audio worker only. Lets that service hold its own
# secret without rotating WORKER_SECRET_TOKEN, which the ffmpeg worker shares.
YOUTUBE_WORKER_TOKEN=replace_me_with_a_generated_secret

# ------------------------------------------------------------------------------
# 5b. YOUTUBE AUDIO WORKER (yt-dlp) — see railway-worker/README.md
# ------------------------------------------------------------------------------
# A SEPARATE service from the ffmpeg worker above, with its own cookies and
# its own token. Do not point this at the ffmpeg worker: that service has its
# own POST /extract-audio handler with different behaviour and no yt-dlp-ejs,
# so extraction fails there in a way that looks like bot detection.
# Leave unset for local dev to fall back to the local yt-dlp strategy.
YOUTUBE_WORKER_URL=https://flowzora-yt-worker.onrender.com

# ------------------------------------------------------------------------------
# 6. APP URL & SPEND CONTROLS
# ------------------------------------------------------------------------------
# Canonical production URL
NEXT_PUBLIC_APP_URL=https://flowzoraclips.com

# Hard monthly spend ceiling in USD before free-tier jobs are gracefully paused
MONTHLY_BUDGET_CAP_USD=50.00

# ------------------------------------------------------------------------------
# 7. YOUTUBE CLOUD INGESTION: RESIDENTIAL PROXY (OPTION A)
# ------------------------------------------------------------------------------
# Bypasses YouTube's AWS/Vercel datacenter IP bot-check restrictions.
# Supports any HTTP, HTTPS, or SOCKS5 residential/mobile proxy (e.g. Webshare, BrightData, Smartproxy).
# Example format: http://username:password@p.webshare.io:80
YOUTUBE_PROXY_URL=http://username:password@proxy-host:port

# [ALTERNATIVE] YouTube Cookie string exported from an active browser session
# YOUTUBE_COOKIE=PREF=...; SID=...; HSID=...
